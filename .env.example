# LabClarity AI Environment Configuration
# Copy this file to .env and configure your keys

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=labclarity-ai-secure-research-key-2026

# Groq API Key (Sign up for free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ngrok Configuration (Sign up for free at https://ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Server Configuration
PORT=5000
HOST=127.0.0.1
